<?xml version="1.0" encoding="UTF-8"?>
<project name="hr-demo" default="deploy" basedir=".">

    <!-- ================= PROPERTIES ================= -->
    <property name="src.dir"       value="src" />
    <property name="web.dir"       value="web" />
    <property name="build.dir"     value="build" />
    <property name="classes.dir"   value="${build.dir}/classes" />
    <property name="dist.dir"      value="dist" />
    <property name="lib.dir"       value="lib" />
    <property name="war.name"      value="hr-demo.war" />

    <!-- Point these at your local Tomcat install to enable the "deploy" target -->
    <property name="tomcat.home" value="/path/to/tomcat" />
    <property name="tomcat.webapps" value="/path/to/tomcat/webapps" />

    <!--
        Build flow:
        clean -> init -> compile -> copy-web -> war -> deploy
        The project expects Servlet API jars from Tomcat and any JCR jars in lib/.
    -->

    <path id="compile.classpath">
        <fileset dir="${lib.dir}">
            <include name="**/*.jar" />
        </fileset>
        <!-- Servlet API is normally provided by Tomcat itself (provided scope),
             not bundled in the WAR - point this at your Tomcat's lib dir -->
        <fileset dir="${tomcat.home}/lib" erroronmissingdir="false">
            <include name="servlet-api.jar" />
        </fileset>
    </path>

    <!-- ================= TARGETS ================= -->

    <target name="clean" description="Remove build artifacts">
        <delete dir="${build.dir}" />
        <delete dir="${dist.dir}" />
    </target>

    <target name="init">
        <mkdir dir="${classes.dir}" />
        <mkdir dir="${dist.dir}" />
    </target>

    <target name="compile" depends="init" description="Compile Java sources">
        <javac srcdir="${src.dir}"
               destdir="${classes.dir}"
               classpathref="compile.classpath"
               includeantruntime="false"
               debug="true" />
    </target>

    <target name="copy-web" depends="compile" description="Assemble the webapp staging directory">
        <copy todir="${classes.dir}">
            <fileset dir="${src.dir}">
                <exclude name="**/*.java" />
            </fileset>
        </copy>
        <copy todir="${build.dir}/webapp">
            <fileset dir="${web.dir}" />
        </copy>
        <copy todir="${build.dir}/webapp/WEB-INF/classes">
            <fileset dir="${classes.dir}" />
        </copy>
        <copy todir="${build.dir}/webapp/WEB-INF/lib">
            <fileset dir="${lib.dir}">
                <include name="**/*.jar" />
            </fileset>
        </copy>
    </target>

    <target name="war" depends="copy-web" description="Package the WAR">
        <war destfile="${dist.dir}/${war.name}"
             webxml="${web.dir}/WEB-INF/web.xml">
            <fileset dir="${build.dir}/webapp">
                <exclude name="WEB-INF/web.xml" />
            </fileset>
        </war>
    </target>

    <target name="deploy" depends="war" description="Copy the WAR into Tomcat's webapps directory">
        <copy file="${dist.dir}/${war.name}" todir="${tomcat.webapps}" />
        <echo message="Deployed ${war.name} to ${tomcat.webapps}. Tomcat will auto-expand and deploy it." />
    </target>

</project>
